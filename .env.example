# Copy to .env and adjust. Never commit the real .env.

# --- Local development (backend reads these; see backend/app/config.py) ---
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/newtonite
TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/newtonite_test
JWT_SECRET=replace-with-a-long-random-string
JWT_TTL_MINUTES=480

# --- docker compose (used by docker-compose.yml) ---
POSTGRES_USER=newtonite
POSTGRES_PASSWORD=newtonite
POSTGRES_DB=newtonite
